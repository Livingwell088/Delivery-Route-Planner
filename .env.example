# Copy this file to .env and replace the placeholder. Never commit .env.
APP_ENVIRONMENT=development
MAP_PROVIDER=google
GOOGLE_MAPS_API_KEY=replace-with-your-private-key

# Country restriction with a soft Worcester-area bias (nearby towns allowed).
GOOGLE_MAPS_REGION=us
GOOGLE_MAPS_COMPONENTS=country:US
GOOGLE_MAPS_BOUNDS=42.20,-71.90|42.35,-71.70

GOOGLE_MAPS_TIMEOUT_SECONDS=10
GOOGLE_MAPS_MAX_ATTEMPTS=2
GOOGLE_MAPS_DEADLINE_SECONDS=20

# Conservative gross-usage allowance; ignores Google's free caps and credits.
# $5 allows 1,000 combined geocoding requests / matrix elements per UTC month.
# This limits THIS backend, not the entire Google Cloud billing account.
GOOGLE_MAPS_MONTHLY_LIMIT_USD=5
GOOGLE_MAPS_GEOCODING_DAILY_LIMIT=500
GOOGLE_MAPS_MATRIX_DAILY_LIMIT=2000
GOOGLE_MAPS_USAGE_DB=data/private/maps-usage.sqlite3
